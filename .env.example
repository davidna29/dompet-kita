APP_NAME="Dompet Kita"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
DEMO_MODE=false

# Production: set APP_ENV=production, APP_DEBUG=false, APP_URL=https://...
# and SESSION_SECURE_COOKIE=true.

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Production: MySQL utf8mb4 (Hostinger). For local development you may switch
# to DB_CONNECTION=sqlite and leave DB_DATABASE as an absolute path.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=dompet_kita
DB_USERNAME=dompet
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Hermes STB admin token. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# Never commit the real value. The UI session auth is separate.
ADMIN_TOKEN=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
